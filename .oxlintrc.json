{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "chrome": "readonly"
  },
  "ignorePatterns": ["node_modules", ".output", ".wxt"]
}
