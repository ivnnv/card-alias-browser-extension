{
  "name": "card-alias-browser-extension",
  "version": "0.1.12",
  "private": true,
  "description": "Chrome extension that shows your own aliases next to masked card numbers like •••• 2071",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun wxt",
    "build": "bun --bun wxt build",
    "zip": "bun --bun wxt zip",
    "postinstall": "bun --bun wxt prepare",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "fixture": "python3 -m http.server 8765 --bind 127.0.0.1",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build",
    "test:e2e": "bun run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.4"
}
